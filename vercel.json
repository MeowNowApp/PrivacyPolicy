{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/privacy/:path*",
      "has": [
        {
          "type": "host",
          "value": "privacy.meownow.app"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "/terms/:path*",
      "has": [
        {
          "type": "host",
          "value": "terms.meownow.app"
        }
      ]
    }
  ]
}